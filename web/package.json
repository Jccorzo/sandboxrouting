{
  "name": "@sandboxrouting/web",
  "version": "0.0.0",
  "private": true,
  "description": "sandboxrouting.com: the marketing and docs site, a static Next.js export. Provider data is generated from the router's registry at build time.",
  "type": "module",
  "scripts": {
    "generate": "node --import tsx scripts/generate.ts",
    "predev": "npm run generate",
    "dev": "next dev",
    "prebuild": "npm run generate",
    "build": "hushrun run --scope web web-build -- next build",
    "pretypecheck": "npm run generate",
    "typecheck": "hushrun run --scope web web-typecheck -- sh -c \"tsc --noEmit && tsc -p scripts --noEmit\"",
    "prelint": "npm run generate",
    "lint": "hushrun run --scope web web-lint -- eslint .",
    "pretest": "npm run generate",
    "test": "hushrun run --scope web web-test -- vitest run",
    "start": "npx serve@14 out"
  },
  "dependencies": {
    "@shikijs/rehype": "^4.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "github-slugger": "^2.0.0",
    "hast-util-to-html": "^9.0.7",
    "lucide-react": "^1.77.0",
    "mdast-util-to-hast": "^13.2.2",
    "mdast-util-to-string": "^4.0.0",
    "next": "^16.4.6",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "^4.6.0",
    "tailwind-merge": "^3.7.1",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@tailwindcss/typography": "^0.5.20",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint-config-next": "^16.4.6",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "vitest": "^4.1.12"
  }
}
