{
  "name": "sandboxrouting",
  "version": "0.1.0",
  "description": "One router for 108 sandbox providers (E2B, Daytona, Modal, Vercel, Cloudflare, Freestyle, Northflank, Luxor (was Tenki), InstaBox, Upstash Box, Boat, Agent37, AWS Lambda MicroVMs and more). Uses every free tier first. SDK, REST API, CLI and MCP server.",
  "keywords": [
    "sandbox",
    "sandboxes",
    "code-sandbox",
    "ai-agents",
    "mcp",
    "mcp-server",
    "e2b",
    "daytona",
    "modal",
    "vercel-sandbox",
    "cloudflare",
    "firecracker",
    "microvm",
    "free-tier",
    "router",
    "failover",
    "code-execution"
  ],
  "type": "module",
  "license": "MIT",
  "mcpName": "com.sandboxrouting/sandboxrouting",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jccorzo/sandboxrouting.git"
  },
  "homepage": "https://github.com/Jccorzo/sandboxrouting#readme",
  "bugs": {
    "url": "https://github.com/Jccorzo/sandboxrouting/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "sbr": "dist/cli.js",
    "sandboxrouting": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./agentrun": {
      "types": "./dist/agentrun/index.d.ts",
      "default": "./dist/agentrun/index.js"
    }
  },
  "files": [
    "dist",
    "templates",
    "README.md"
  ],
  "workspaces": [
    "back",
    "dashboard",
    "web"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "typecheck": "hushrun run --scope router -- tsc -p tsconfig.json --noEmit",
    "lint": "hushrun run --scope router -- eslint .",
    "test": "hushrun run --scope router -- vitest run",
    "dev:cli": "node --import tsx src/cli.ts",
    "simulate": "node --import tsx bench/simulate.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^3.25.76"
  },
  "peerDependencies": {
    "@aws-sdk/client-lambda-microvms": "*",
    "@beamcloud/beam-js": "*",
    "@blaxel/core": "*",
    "@boxd-sh/sdk": "*",
    "@boxlite-ai/boxlite": "*",
    "@celestoai/sdk": "*",
    "@daytona/sdk": "*",
    "@depot/sandbox": "*",
    "@koyeb/sandbox-sdk": "*",
    "@namespacelabs/sdk": "*",
    "@northflank/js-client": "*",
    "@parcha/agentrun-computer": "*",
    "@runloop/api-client": "*",
    "@runta/runta-sdk": "*",
    "@tenkicloud/sandbox": "*",
    "@upstash/box": "*",
    "@vercel/sandbox": "*",
    "@watasu/sdk": "*",
    "disk": "*",
    "e2b": "*",
    "freestyle": "*",
    "modal": "*",
    "morphcloud": "*",
    "together-sandbox": "*"
  },
