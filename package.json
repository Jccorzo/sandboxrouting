{
  "name": "sandboxrouting",
  "version": "0.1.0",
  "description": "One router for 108 sandbox providers (E2B, Daytona, Modal, Vercel, Cloudflare, Freestyle, Northflank, Luxor (was Tenki), InstaBox, Upstash Box, Boat, Agent37, AWS Lambda MicroVMs and more). Uses every free tier first. SDK, REST API, CLI and MCP server.",
  "keywords": [
    "sandbox",
    "sandboxes",
    "code-sandbox",
    "ai-agents",
    "mcp",
    "mcp-server",
    "e2b",
    "daytona",
    "modal",
    "vercel-sandbox",
    "cloudflare",
    "firecracker",
    "microvm",
    "free-tier",
    "router",
    "failover",
    "code-execution"
  ],
  "type": "module",
  "license": "MIT",
  "mcpName": "com.sandboxrouting/sandboxrouting",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jccorzo/sandboxrouting.git"
  },
  "homepage": "https://github.com/Jccorzo/sandboxrouting#readme",
  "bugs": {
    "url": "https://github.com/Jccorzo/sandboxrouting/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "sbr": "dist/cli.js",
    "sandboxrouting": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./agentrun": {
      "types": "./dist/agentrun/index.d.ts",
      "default": "./dist/agentrun/index.js"
    }
  },
  "files": [
    "dist",
    "templates",
    "README.md"
  ],
  "workspaces": [
    "back",
    "dashboard",
    "web"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "typecheck": "hushrun run --scope router -- tsc -p tsconfig.json --noEmit",
    "lint": "hushrun run --scope router -- eslint .",
    "test": "hushrun run --scope router -- vitest run",
    "dev:cli": "node --import tsx src/cli.ts",
    "simulate": "node --import tsx bench/simulate.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@watasu/sdk": "^0.1.77",
    "zod": "^3.25.76"
  },
  "peerDependencies": {
    "@beamcloud/beam-js": "*",
    "@boxd-sh/sdk": "*",
    "@boxlite-ai/boxlite": "*",
    "@northflank/js-client": "*",
    "@parcha/agentrun-computer": "*",
    "@runta/runta-sdk": "*",
    "disk": "*",
    "modal": "*"
  },
  "peerDependenciesMeta": {
    "@beamcloud/beam-js": {
      "optional": true
    },
    "@boxd-sh/sdk": {
      "optional": true
    },
    "@boxlite-ai/boxlite": {
      "optional": true
    },
    "@northflank/js-client": {
      "optional": true
    },
    "@parcha/agentrun-computer": {
      "optional": true
    },
    "@runta/runta-sdk": {
      "optional": true
    },
    "disk": {
      "optional": true
    },
    "modal": {
      "optional": true
    }
  },
  "devDependencies": {
    "@beamcloud/beam-js": "^1.1.6",
    "@boxd-sh/sdk": "^0.3.2",
    "@boxlite-ai/boxlite": "^0.12.0",
    "@eslint/js": "^9.39.5",
    "@northflank/js-client": "^0.9.5",
    "@parcha/agentrun-computer": "0.1.0-beta.51",
    "@runta/runta-sdk": "^0.2.0",
    "@types/node": "^20.19.0",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "hushrun": "^0.15.0",
    "modal": "^0.11.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^4.1.12"
  },
  "hushrun": {
    "backend": "https://api.hushrun.com/o/jccorzot"
  }
}
