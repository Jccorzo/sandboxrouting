    },
    "@namespacelabs/sdk": {
      "optional": true
    },
    "@northflank/js-client": {
      "optional": true
    },
    "@parcha/agentrun-computer": {
      "optional": true
    },
    "@runloop/api-client": {
      "optional": true
    },
    "@runta/runta-sdk": {
      "optional": true
    },
    "@tenkicloud/sandbox": {
