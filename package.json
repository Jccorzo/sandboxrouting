{
  "name": "sandboxrouting",
  "version": "0.1.0",
  "description": "One router for 31 cloud sandbox providers (E2B, Daytona, Modal, Vercel, Cloudflare, Freestyle, Northflank, Tenki, InstaBox, Upstash Box, Boat, Agent37, AWS Lambda MicroVMs and more). Uses every free tier first. SDK, REST API, CLI and MCP server.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "sbr": "dist/cli.js",
    "sandboxrouting": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "templates",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev:cli": "node --import tsx src/cli.ts",
    "simulate": "node --import tsx bench/simulate.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^3.25.76"
  },
  "peerDependencies": {
    "@aws-sdk/client-lambda-microvms": "*",
    "@blaxel/core": "*",
    "@boxlite-ai/boxlite": "*",
    "@celestoai/sdk": "*",
    "@daytona/sdk": "*",
    "@depot/sandbox": "*",
    "@koyeb/sandbox-sdk": "*",
    "@namespacelabs/sdk": "*",
    "@northflank/js-client": "*",
    "@runloop/api-client": "*",
    "@tenkicloud/sandbox": "*",
    "@upstash/box": "*",
    "@vercel/sandbox": "*",
    "e2b": "*",
    "freestyle": "*",
    "modal": "*",
    "morphcloud": "*",
    "together-sandbox": "*"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-lambda-microvms": {
      "optional": true
    },
    "@blaxel/core": {
      "optional": true
    },
    "@boxlite-ai/boxlite": {
      "optional": true
    },
    "@celestoai/sdk": {
      "optional": true
    },
    "@daytona/sdk": {
      "optional": true
    },
    "@depot/sandbox": {
      "optional": true
    },
    "@koyeb/sandbox-sdk": {
      "optional": true
    },
    "@namespacelabs/sdk": {
      "optional": true
    },
    "@northflank/js-client": {
      "optional": true
    },
    "@runloop/api-client": {
      "optional": true
    },
    "@tenkicloud/sandbox": {
      "optional": true
    },
    "@upstash/box": {
      "optional": true
    },
    "@vercel/sandbox": {
      "optional": true
    },
    "e2b": {
      "optional": true
    },
    "freestyle": {
      "optional": true
    },
    "modal": {
      "optional": true
    },
    "morphcloud": {
      "optional": true
    },
    "together-sandbox": {
      "optional": true
    }
  },
  "devDependencies": {
    "@aws-sdk/client-lambda-microvms": "^3.1167.0",
    "@blaxel/core": "^0.3.37",
    "@boxlite-ai/boxlite": "^0.12.0",
    "@celestoai/sdk": "^0.1.6",
    "@daytona/sdk": "^0.231.1",
    "@depot/sandbox": "^0.1.0-beta.7",
    "@koyeb/sandbox-sdk": "^1.1.0",
    "@namespacelabs/sdk": "^1.6.0",
    "@northflank/js-client": "^0.9.5",
    "@runloop/api-client": "^3.0.0",
    "@tenkicloud/sandbox": "^1.5.1",
    "@types/node": "^20.19.0",
    "@upstash/box": "^0.7.10",
    "@vercel/sandbox": "^3.9.1",
    "e2b": "^2.55.0",
    "freestyle": "^0.2.23",
