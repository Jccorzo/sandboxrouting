# Copy to deploy/.env and fill in. Make each token with: openssl rand -base64 32
POSTGRES_PASSWORD=
# Signs in to the dashboard (an admin key on the first account). At least 24 characters.
SBR_ADMIN_TOKEN=
# Optional: an ingest key for routers, so you can start reporting before opening the dashboard.
SBR_INGEST_TOKEN=
# Optional: lets the sweep (or any cron) call POST /v1/sweep for every account.
SBR_SWEEP_TOKEN=
# Where routers reach back, shown in the dashboard's setup snippet.
BACK_PUBLIC_URL=http://localhost:8787
# BACK_PORT=8787
# DASHBOARD_PORT=3000
