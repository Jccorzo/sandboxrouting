# Copy to deploy/.env and fill in. Make each token with: openssl rand -base64 32
POSTGRES_PASSWORD=
# Signs in to the dashboard (an admin key on the first account). At least 24 characters.
SBR_ADMIN_TOKEN=
# Optional: an ingest key for routers, so you can start reporting before opening the dashboard.
SBR_INGEST_TOKEN=
# Optional: lets the sweep (or any cron) call POST /v1/sweep for every account.
SBR_SWEEP_TOKEN=
# Where routers reach back, shown in the dashboard's setup snippet.
BACK_PUBLIC_URL=http://localhost:8787
# BACK_PORT=8787
# DASHBOARD_PORT=3000
# Optional, together: GitHub sign-in instead of admin keys. Make a GitHub OAuth app whose
# callback URL is <DASHBOARD_PUBLIC_URL>/api/auth/github/callback. A first sign-in makes an account.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# The dashboard's address as browsers reach it (used for GitHub's callback), e.g. https://dash.example
# DASHBOARD_PUBLIC_URL=
# Optional: lets people save provider keys (for the hosted router), sealed with this key.
# Make it with: openssl rand -base64 32. Losing it loses every saved key.
# SBR_SECRETS_KEY=
# Optional: the hosted router (--profile router) runs on those saved keys. Its address as router
# keys reach it, for the dashboard's setup snippet, e.g. http://localhost:8788
# ROUTER_PUBLIC_URL=
# ROUTER_PORT=8788
# SBR_HOSTED_MAX_LIVE=10
